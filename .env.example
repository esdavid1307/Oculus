# Copy to .env and fill in. .env is git-ignored.
# Only for OCULUS_AGENT_BACKEND=api. The default claude-code backend uses your Claude Code login instead.
# Key from console.anthropic.com. A Claude subscription doesn't include API access.
ANTHROPIC_API_KEY=

# Optional agent check settings, see docs/agent-check.md.
# OCULUS_AGENT_CHECK=In Google Chrome, click the address bar, type example.com and press Return.
# OCULUS_AGENT_BACKEND=api
# OCULUS_AGENT_KEEP_OPEN=1
# OCULUS_AGENT_MODEL=claude-sonnet-5-5
# OCULUS_AGENT_EFFORT=low
# OCULUS_AGENT_MAX_STEPS=5
# OCULUS_AGENT_SHOW_OVERLAY=1
